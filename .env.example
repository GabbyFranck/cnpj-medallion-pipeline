# Copied to .env by `make up` (AIRFLOW_UID is appended automatically).

# --- Airflow -----------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me
SPARK_POOL=spark
SPARK_POOL_SLOTS=1

# --- Source ------------------------------------------------------------------
CNPJ_BASE_URL=https://dados-abertos-rf-cnpj.casadosdados.com.br/arquivos/
# Empty = latest release on the mirror. Example: 2026-10-13
CNPJ_RELEASE=
# Which numbered files to ingest per table (Empresas0..9, ...): "all", "1", "0-3", "0,5".
# The default ("1") keeps a local run around ~450 MB of zips; "all" is ~7 GB of zips.
CNPJ_FILE_PARTS=1

# --- Lake ----------------------------------------------------------------------
# Local folder that mimics S3 buckets; set LAKE_ROOT=s3 to target s3a://<bucket>/.
BRONZE_BUCKET=datacorp-bronze
SILVER_BUCKET=datacorp-silver
GOLD_BUCKET=datacorp-gold

# --- Spark ---------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=64

# --- Data quality --------------------------------------------------------------
DQ_MAX_CORRUPT_RATIO=0.001
DQ_MAX_ORPHAN_RATIO=0.05
